<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Same source for all four variants; the target is chosen at publish time with -f. -->
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Keep the code free of C# 15 features so it also builds for net10.0. -->
    <LangVersion>14</LangVersion>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <!-- Native AOT is switched on only when requested: dotnet publish -p:Aot=true -->
  <PropertyGroup Condition="'$(Aot)' == 'true'">
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>

</Project>
